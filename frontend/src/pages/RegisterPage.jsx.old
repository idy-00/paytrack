const TICKER_AMOUNTS = [
  { amount: '850 000', label: 'Tranche encaissée', color: 'rgba(255,255,255,0.70)' },
  { amount: '320 500', label: 'Règlement Wave',    color: 'rgba(255,255,255,0.35)' },
  { amount: '1 200 000', label: 'Dossier soldé',   color: 'rgba(46,125,90,0.80)' },
  { amount: '108 334', label: 'Rappel envoyé',     color: 'rgba(255,255,255,0.35)' },
  { amount: '475 000', label: 'Orange Money',      color: 'rgba(255,255,255,0.70)' },
  { amount: '660 000', label: 'QR scanné',         color: 'rgba(255,255,255,0.35)' },
  { amount: '95 000',  label: 'Reçu PDF généré',   color: 'rgba(46,125,90,0.80)' },
  { amount: '2 100 000', label: 'Compte soldé',    color: 'rgba(255,255,255,0.70)' },
]

function AmountTicker({ offset = 0, speed = 'animate-ticker' }) {
  const items = [...TICKER_AMOUNTS, ...TICKER_AMOUNTS]
  return (
    <div style={{ overflow: 'hidden', height: '100%', position: 'relative' }}>
      <div className={speed} style={{ display: 'flex', flexDirection: 'column', gap: '20px', marginTop: offset }}>
        {items.map((item, i) => (
          <div key={i} style={{ display: 'flex', alignItems: 'baseline', gap: '8px', flexShrink: 0 }}>
            <span style={{
              fontFamily: '"JetBrains Mono", monospace',
              fontWeight: 600, fontSize: '15px',
              color: item.color,
              fontVariantNumeric: 'tabular-nums',
              letterSpacing: '-0.02em', lineHeight: 1,
            }}>
              {item.amount}
            </span>
            <span style={{
              fontFamily: '"Plus Jakarta Sans", sans-serif',
              fontSize: '10px',
              color: 'rgba(246,242,236,0.25)',
              letterSpacing: '0.04em', lineHeight: 1,
            }}>
              F CFA · {item.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  )
}

