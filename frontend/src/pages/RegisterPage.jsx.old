/* ─────────────────────────────────────────────────────────────────────────
   SHARED: Mosquée geometric pattern (reused from Login)
───────────────────────────────────────────────────────────────────────── */
function MosqueePattern({ opacity = 0.04 }) {
  return (
    <svg
      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', opacity }}
      aria-hidden="true"
    >
      <defs>
        <pattern id="mosque-geo-reg" x="0" y="0" width="72" height="72" patternUnits="userSpaceOnUse">
          <polygon points="24,0 48,0 72,24 72,48 48,72 24,72 0,48 0,24"
            fill="none" stroke="#1A2332" strokeWidth="1" />
          <polygon points="36,12 60,36 36,60 12,36"
            fill="none" stroke="#1A2332" strokeWidth="0.75" />
          <polygon points="36,22 40,32 50,32 42,38 45,50 36,44 27,50 30,38 22,32 32,32"
            fill="none" stroke="#1A2332" strokeWidth="0.6" />
          <polygon points="0,0 6,12 0,24" fill="none" stroke="#1A2332" strokeWidth="0.5" />
          <polygon points="72,0 66,12 72,24" fill="none" stroke="#1A2332" strokeWidth="0.5" />
          <polygon points="0,72 6,60 0,48" fill="none" stroke="#1A2332" strokeWidth="0.5" />
          <polygon points="72,72 66,60 72,48" fill="none" stroke="#1A2332" strokeWidth="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#mosque-geo-reg)" />
    </svg>
  )
}

