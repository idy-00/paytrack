/* ─────────────────────────────────────────────────────────────────────────
   RIPPLE HOOK
───────────────────────────────────────────────────────────────────────── */
function useRipple() {
  const [ripples, setRipples] = useState([])
  const addRipple = useCallback((e) => {
    const rect = e.currentTarget.getBoundingClientRect()
    const x = e.clientX - rect.left - 24
    const y = e.clientY - rect.top - 24
    const id = Date.now()
    setRipples(r => [...r, { id, x, y }])
    setTimeout(() => setRipples(r => r.filter(rr => rr.id !== id)), 620)
  }, [])
  return [ripples, addRipple]
}

/* ─────────────────────────────────────────────────────────────────────────
   REGISTER LINE INPUT — cream-background variant
───────────────────────────────────────────────────────────────────────── */
function RegInput({ id, label, type = 'text', value, onChange, autoComplete, required, extra }) {
  return (
    <div className="reg-input-wrap" style={extra || {}}>
      <input
        id={id}
        type={type}
        autoComplete={autoComplete}
        required={required}
        value={value}
        onChange={onChange}
        className="reg-input"
        placeholder=" "
      />
      <label htmlFor={id}>{label}</label>
    </div>
  )
}

/* ─────────────────────────────────────────────────────────────────────────
   PASSWORD STRENGTH
───────────────────────────────────────────────────────────────────────── */
function PasswordStrength({ password }) {
  if (!password) return null
  const checks = [
    { label: '8 caractères', ok: password.length >= 8 },
    { label: 'Majuscule',    ok: /[A-Z]/.test(password) },
    { label: 'Chiffre',      ok: /\d/.test(password) },
    { label: 'Spécial',      ok: /[^A-Za-z0-9]/.test(password) },
  ]
  const score = checks.filter(c => c.ok).length
  const barColors = ['#E0D8CF', '#B82929', '#C46318', 'rgba(255,255,255,0.7)', '#2E7D5A']
  const scoreLabels = ['', 'Faible', 'Moyen', 'Bon', 'Fort']

  return (
    <div style={{ marginTop: '10px' }}>
      <div style={{ display: 'flex', gap: '4px', alignItems: 'center', marginBottom: '8px' }}>
        {[1,2,3,4].map(i => (
          <div key={i} style={{
            flex: 1, height: '3px', borderRadius: '2px',
            background: i <= score ? barColors[score] : '#E0D8CF',
            transition: 'background 300ms ease',
          }} />
        ))}
        <span style={{
          fontFamily: '"Plus Jakarta Sans", sans-serif',
          fontSize: '10px', fontWeight: 600,
          color: barColors[score] || '#9B887A',
          marginLeft: '6px', minWidth: '32px',
        }}>
          {scoreLabels[score]}
        </span>
      </div>
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '4px' }}>
        {checks.map(({ label, ok }) => (
          <div key={label} style={{
            display: 'flex', alignItems: 'center', gap: '5px',
            fontFamily: '"Plus Jakarta Sans", sans-serif',
            fontSize: '10px',
            color: ok ? '#2E7D5A' : '#9B887A',
            transition: 'color 200ms',
          }}>
            <div style={{
              width: 12, height: 12, borderRadius: '50%',
              background: ok ? 'rgba(46,125,90,0.12)' : '#F6F2EC',
              border: `1px solid ${ok ? 'rgba(46,125,90,0.50)' : '#E0D8CF'}`,
              display: 'flex', alignItems: 'center', justifyContent: 'center',
              flexShrink: 0,
              transition: 'all 200ms',
            }}>
              {ok && (
                <svg width="7" height="7" viewBox="0 0 7 7" fill="none">
                  <path d="M1.5 3.5l1.5 1.5 2.5-2.5" stroke="#2E7D5A" strokeWidth="1.2" strokeLinecap="round" strokeLinejoin="round"/>
                </svg>
              )}
            </div>
            {label}
          </div>
        ))}
      </div>
    </div>
  )
}

/* ─────────────────────────────────────────────────────────────────────────
   STEP INDICATOR — horizontal ruled lines like a register column header
───────────────────────────────────────────────────────────────────────── */
function StepIndicator({ step, total }) {
  return (
    <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
      {Array.from({ length: total }, (_, i) => (
        <div key={i} style={{
          height: '3px',
          borderRadius: '2px',
          transition: 'all 300ms cubic-bezier(0.16, 1, 0.3, 1)',
          background: i < step ? 'rgba(255,255,255,0.7)' : i === step ? '#1A2332' : '#E0D8CF',
          width: i === step ? '28px' : i < step ? '16px' : '8px',
        }} />
      ))}
      <span style={{
        fontFamily: '"Plus Jakarta Sans", sans-serif',
        fontSize: '11px',
        color: '#9B887A',
        marginLeft: '4px',
        fontVariantNumeric: 'tabular-nums',
      }}>
        {step + 1}/{total}
      </span>
    </div>
  )
}

