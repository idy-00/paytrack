                fontSize: '27px', fontWeight: 700,
                color: '#1A140C',
                letterSpacing: '-0.018em',
                margin: '0 0 5px',
                lineHeight: 1.1,
              }}>
                {step === 0 ? 'Ouvrir un registre' : 'Votre boutique'}
              </h1>
              <p style={{
                fontFamily: '"DM Serif Display", Georgia, serif',
                fontStyle: 'italic', fontWeight: 300,
                fontSize: '14px',
                color: '#9B887A',
                margin: 0,
              }}>
                {step === 0 ? 'Essai gratuit 14 jours · Sans carte bancaire' : 'Quelques infos sur votre activité'}
              </p>
            </div>
            <StepIndicator step={step} total={2} />
          </div>

          {/* Gold rule */}
          <div style={{
            width: '48px', height: '1px',
            background: 'rgba(255,255,255,0.45)',
            marginBottom: '32px',
          }} />

          {/* ── STEP 0: Personal info ── */}
          {step === 0 && (
            <form
              onSubmit={handleStep0}
              className="animate-slide-up"
              style={{ display: 'flex', flexDirection: 'column', gap: '28px' }}
            >
              {/* Name */}
              <RegInput
                id="reg-name"
                label="Nom complet"
                value={form.name}
                onChange={e => up('name', e.target.value)}
                autoComplete="name"
                required
              />

              {/* Email */}
              <RegInput
                id="reg-email"
                label="Email professionnel"
                type="email"
                value={form.email}
                onChange={e => up('email', e.target.value)}
                autoComplete="email"
                required
              />

              {/* Phone */}
              <RegInput
                id="reg-phone"
                label="Téléphone (optionnel)"
                type="tel"
                value={form.phone}
                onChange={e => up('phone', e.target.value)}
                autoComplete="tel"
              />

              {/* Password */}
              <div className="reg-input-wrap" style={{ position: 'relative' }}>
                <input
                  id="reg-password"
                  type={showPass ? 'text' : 'password'}
                  autoComplete="new-password"
                  required
                  minLength={8}
                  value={form.password}
                  onChange={e => up('password', e.target.value)}
                  className="reg-input"
                  style={{ paddingRight: '28px' }}
                  placeholder=" "
                />
                <label htmlFor="reg-password">Mot de passe</label>
                <button
                  type="button"
                  className="reg-pass-toggle"
                  onClick={() => setShowPass(v => !v)}
                  aria-label={showPass ? 'Masquer' : 'Afficher'}
                >
                  {showPass ? <EyeOff size={14} /> : <Eye size={14} />}
                </button>
                <PasswordStrength password={form.password} />
              </div>

              {/* Submit */}
              <button
                type="submit"
                disabled={!form.name || !form.email || form.password.length < 8}
                style={{
                  ...submitBtn,
                  opacity: (!form.name || !form.email || form.password.length < 8) ? 0.5 : 1,
                  cursor: (!form.name || !form.email || form.password.length < 8) ? 'not-allowed' : 'pointer',
                }}
                onClick={(!form.name || !form.email || form.password.length < 8) ? undefined : addRipple}
              >
                {ripples.map(r => (
                  <span key={r.id} style={{
                    position: 'absolute',
                    borderRadius: '50%',
                    width: '48px', height: '48px',
                    background: 'rgba(255,255,255,0.18)',
                    left: r.x, top: r.y,
                    pointerEvents: 'none',
                    transform: 'scale(0)',
                    animation: 'ripple 600ms ease-out forwards',
                  }} />
                ))}
                Continuer <ArrowRight size={15} />
              </button>

              <p style={{
                textAlign: 'center',
                fontFamily: '"Plus Jakarta Sans", sans-serif',
                fontSize: '13px', color: '#9B887A',
                margin: 0,
              }}>
                Déjà inscrit ?{' '}
                <Link to="/login" style={{
                  color: '#1A2332', fontWeight: 600,
                  textDecoration: 'none',
                  borderBottom: '1px solid rgba(123,74,30,0.30)',
                  paddingBottom: '1px',
                }}>
                  Se connecter
                </Link>
              </p>
            </form>
          )}

          {/* ── STEP 1: Boutique info ── */}
          {step === 1 && (
            <form
              onSubmit={handleSubmit}
              className="animate-slide-up"
              style={{ display: 'flex', flexDirection: 'column', gap: '28px' }}
            >
              {/* Shop name */}
              <RegInput
                id="reg-shop"
                label="Nom de la boutique"
                value={form.shop_name}
                onChange={e => up('shop_name', e.target.value)}
                autoComplete="organization"
                required
              />

              {/* City */}
              <RegInput
                id="reg-city"
                label="Ville"
                value={form.city}
                onChange={e => up('city', e.target.value)}
                autoComplete="address-level2"
                required
              />

              {/* Activity */}
              <div>
                <p style={{
                  fontFamily: '"Plus Jakarta Sans", sans-serif',
                  fontSize: '11px', fontWeight: 600,
                  letterSpacing: '0.08em', textTransform: 'uppercase',
                  color: '#9B887A',
                  margin: '0 0 12px',
                }}>
                  Secteur d'activité
                </p>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
                  {ACTIVITIES.map(act => (
                    <button
                      key={act}
                      type="button"
                      onClick={() => up('activity', act)}
                      style={{
                        padding: '9px 12px',
                        borderRadius: '8px',
                        fontFamily: '"Plus Jakarta Sans", sans-serif',
                        fontSize: '12px', fontWeight: 500,
                        textAlign: 'left',
                        cursor: 'pointer',
                        transition: 'all 160ms ease',
                        border: form.activity === act
                          ? '1.5px solid #1A2332'
                          : '1.5px solid #E0D8CF',
                        background: form.activity === act
                          ? 'rgba(123,74,30,0.08)'
                          : '#FFFFFF',
                        color: form.activity === act
                          ? '#1A2332'
                          : '#5C4A36',
                        ...(form.activity === act ? {
                          boxShadow: '0 0 0 3px rgba(255,255,255,0.12)',
                        } : {}),
                      }}
                    >
                      {act}
                    </button>
                  ))}
                </div>
              </div>

              {/* Team size */}
              <div>
                <p style={{
                  fontFamily: '"Plus Jakarta Sans", sans-serif',
                  fontSize: '11px', fontWeight: 600,
                  letterSpacing: '0.08em', textTransform: 'uppercase',
                  color: '#9B887A',
                  margin: '0 0 12px',
                }}>
                  Taille de l'équipe
                </p>
                <div style={{ display: 'flex', gap: '8px' }}>
                  {['1-5','6-20','21-50','50+'].map(size => (
                    <button
                      key={size}
                      type="button"
                      onClick={() => up('employees', size)}
                      style={{
                        flex: 1,
                        padding: '10px 0',
                        borderRadius: '8px',
                        fontFamily: '"JetBrains Mono", monospace',
                        fontSize: '12px', fontWeight: 600,
                        cursor: 'pointer',
                        transition: 'all 160ms ease',
                        border: form.employees === size
                          ? '1.5px solid rgba(255,255,255,0.7)'
                          : '1.5px solid #E0D8CF',
                        background: form.employees === size
                          ? 'rgba(255,255,255,0.10)'
                          : '#FFFFFF',
                        color: form.employees === size
                          ? 'rgba(255,255,255,0.7)'
                          : '#9B887A',
                      }}
                    >
                      {size}
                    </button>
                  ))}
                </div>
              </div>

              {/* Terms */}
              <div style={{
                background: '#FFFFFF',
                border: '1px solid #E0D8CF',
                borderRadius: '8px',
                padding: '12px 14px',
                fontFamily: '"Plus Jakarta Sans", sans-serif',
                fontSize: '11px',
                color: '#9B887A',
                lineHeight: 1.6,
              }}>
                En créant un compte, vous acceptez nos{' '}
                <a href="#" style={{ color: '#1A2332', textDecoration: 'none', borderBottom: '1px solid rgba(123,74,30,0.25)' }}>
                  Conditions d'utilisation
                </a>
                {' '}et notre{' '}
                <a href="#" style={{ color: '#1A2332', textDecoration: 'none', borderBottom: '1px solid rgba(123,74,30,0.25)' }}>
                  Politique de confidentialité
                </a>.
              </div>

              {/* Actions */}
              <div style={{ display: 'flex', gap: '10px' }}>
                <button
                  type="button"
                  onClick={() => setStep(0)}
                  style={{
                    height: '48px',
                    padding: '0 18px',
                    display: 'flex', alignItems: 'center', gap: '6px',
                    background: '#FFFFFF',
                    border: '1.5px solid #E0D8CF',
                    borderRadius: '8px',
                    cursor: 'pointer',
                    fontFamily: '"Plus Jakarta Sans", sans-serif',
                    fontSize: '13px', fontWeight: 500,
                    color: '#5C4A36',
                    flexShrink: 0,
                    transition: 'border-color 160ms, background 160ms',
                  }}
                  onMouseEnter={e => {
                    e.currentTarget.style.borderColor = '#C5B9AC'
                    e.currentTarget.style.background = '#FBF8F4'
                  }}
                  onMouseLeave={e => {
                    e.currentTarget.style.borderColor = '#E0D8CF'
                    e.currentTarget.style.background = '#FFFFFF'
                  }}
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M8.5 2.5L4 7l4.5 4.5" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round"/>
                  </svg>
                  Retour
                </button>

                <button
                  type="submit"
                  disabled={loading || !form.shop_name || !form.city}
                  onClick={(loading || !form.shop_name || !form.city) ? undefined : addRipple}
                  style={{
                    ...submitBtn,
                    flex: 1, marginTop: 0,
                    opacity: (loading || !form.shop_name || !form.city) ? 0.55 : 1,
                    cursor: (loading || !form.shop_name || !form.city) ? 'not-allowed' : 'pointer',
                    background: '#2E7D5A',
                    boxShadow: '0 2px 12px rgba(46,125,90,0.22)',
                  }}
                  onMouseEnter={e => {
                    if (!loading && form.shop_name && form.city) {
                      e.currentTarget.style.transform = 'translateY(-1px)'
                      e.currentTarget.style.boxShadow = '0 6px 20px rgba(46,125,90,0.28)'
                    }
                  }}
                  onMouseLeave={e => {
                    e.currentTarget.style.transform = 'translateY(0)'
                    e.currentTarget.style.boxShadow = '0 2px 12px rgba(46,125,90,0.22)'
                  }}
                >
                  {ripples.map(r => (
                    <span key={r.id} style={{
                      position: 'absolute',
                      borderRadius: '50%',
                      width: '48px', height: '48px',
                      background: 'rgba(255,255,255,0.20)',
                      left: r.x, top: r.y,
                      pointerEvents: 'none',
                      transform: 'scale(0)',
                      animation: 'ripple 600ms ease-out forwards',
                    }} />
                  ))}
                  {loading ? (
                    <span style={{
                      width: 16, height: 16,
                      border: '2px solid rgba(255,255,255,0.25)',
                      borderTopColor: '#FFFFFF',
                      borderRadius: '50%',
                      animation: 'spin 700ms linear infinite',
                      display: 'inline-block',
                    }} />
                  ) : (
                    <>Créer mon registre <ArrowRight size={15} /></>
                  )}
                </button>
              </div>
            </form>
          )}
        </div>
      </div>

      <style>{`
        @keyframes spin {
          to { transform: rotate(360deg); }
        }
        @keyframes ripple {
          0%   { transform: scale(0); opacity: 0.35; }
          100% { transform: scale(4); opacity: 0; }
        }
      `}</style>
    </div>
  )
}
