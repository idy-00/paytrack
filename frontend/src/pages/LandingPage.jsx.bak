        textAnchor="middle" letterSpacing="0.04em">DOSSIER QR</text>
      <text x="130" y="40" fill="rgba(255,255,255,0.5)" fontSize="7" fontFamily="'Plus Jakarta Sans', sans-serif"
        textAnchor="middle">VT-2026-0091 · Moussa Diallo</text>
      {/* QR finders */}
      <rect x="30" y="70" width="42" height="42" rx="6" fill="#1A140C"/>
      <rect x="35" y="75" width="32" height="32" rx="3" fill="#FBF8F4"/>
      <rect x="40" y="80" width="22" height="22" rx="1" fill="#1A140C"/>
      <rect x="188" y="70" width="42" height="42" rx="6" fill="#1A140C"/>
      <rect x="193" y="75" width="32" height="32" rx="3" fill="#FBF8F4"/>
      <rect x="198" y="80" width="22" height="22" rx="1" fill="#1A140C"/>
      <rect x="30" y="148" width="42" height="42" rx="6" fill="#1A140C"/>
      <rect x="35" y="153" width="32" height="32" rx="3" fill="#FBF8F4"/>
      <rect x="40" y="158" width="22" height="22" rx="1" fill="#1A140C"/>
      {/* Data dots */}
      {[
        [188,150],[194,150],[200,150],[206,150],[212,150],
        [188,156],[200,156],[206,156],
        [194,162],[200,162],[212,162],
        [188,168],[194,168],[206,168],[212,168],
        [188,174],[200,174],[206,174],
        [194,180],[212,180],
        [188,186],[200,186],[206,186],[212,186],
      ].map(([x, y], i) => (
        <rect key={i} x={x} y={y} width="5" height="5" rx="1" fill="#1A140C" opacity={0.75}/>
      ))}
      {/* Central brand mark */}
      <rect x="108" y="118" width="44" height="24" rx="4" fill="#7B4A1E"/>
      <text x="130" y="133" fill="#D4891A" fontSize="9" fontFamily="'Fraunces', serif" fontWeight="600"
        textAnchor="middle">PT</text>
      <text x="130" y="210" fill="#9B887A" fontSize="7.5" fontFamily="'Plus Jakarta Sans', sans-serif"
        textAnchor="middle">Scanner pour consulter votre dossier</text>
      {/* Progress */}
      <rect x="30" y="222" width="200" height="5" rx="2.5" fill="#E0D8CF"/>
      <rect x="30" y="222" width="120" height="5" rx="2.5" fill="#D4891A"/>
      <text x="130" y="242" fill="#9B887A" fontSize="7" fontFamily="'JetBrains Mono', monospace"
        textAnchor="middle">3 / 6 tranches · 225 000 FCFA payés</text>
    </svg>
  )
}

function IlluReceiptNew() {
  return (
    <svg viewBox="0 0 220 280" fill="none" xmlns="http://www.w3.org/2000/svg" className="w-full h-full">
      <defs>
        <filter id="rcShadow">
          <feDropShadow dx="0" dy="6" stdDeviation="10" floodColor="#7B4A1E" floodOpacity="0.12"/>
        </filter>
      </defs>
      <rect x="10" y="0" width="200" height="250" rx="12" fill="white" filter="url(#rcShadow)"/>
      <path d="M10 242 Q20 230 30 242 Q40 254 50 242 Q60 230 70 242 Q80 254 90 242 Q100 230 110 242 Q120 254 130 242 Q140 230 150 242 Q160 254 170 242 Q180 230 190 242 Q200 254 210 242 L210 250 Q210 262 198 262 L22 262 Q10 262 10 250Z"
        fill="#F6F2EC"/>
      <rect x="10" y="0" width="200" height="56" rx="12" fill="#7B4A1E"/>
      <rect x="10" y="44" width="200" height="12" fill="#7B4A1E"/>
      <text x="110" y="22" fill="white" fontSize="12" fontFamily="'Fraunces', serif" fontWeight="600"
        textAnchor="middle">PayTrack</text>
      <text x="110" y="38" fill="rgba(255,255,255,0.5)" fontSize="7.5" fontFamily="'Plus Jakarta Sans', sans-serif"
        textAnchor="middle">Reçu de paiement confirmé</text>
      <text x="110" y="84" fill="#2E7D5A" fontSize="22" fontFamily="'JetBrains Mono', monospace" fontWeight="600"
        textAnchor="middle">62 500 FCFA</text>
      <text x="110" y="98" fill="#9B887A" fontSize="7.5" fontFamily="'Plus Jakarta Sans', sans-serif"
        textAnchor="middle">Tranche 3/6 · RC-A4F2B9</text>
      <line x1="28" y1="108" x2="192" y2="108" stroke="#F6F2EC" strokeWidth="1"/>
      {[
        { label: 'Client', value: 'Moussa Diallo', y: 122 },
        { label: 'Article', value: 'Galaxy A35', y: 140 },
        { label: 'Référence', value: 'VT-2026-0091', y: 158 },
        { label: 'Mode', value: 'Wave', y: 176 },
        { label: 'Date', value: '03 Juil 2026', y: 194 },
      ].map(({ label, value, y }) => (
        <g key={y}>
          <text x="28" y={y} fill="#9B887A" fontSize="7.5" fontFamily="'Plus Jakarta Sans', sans-serif">{label}</text>
          <text x="192" y={y} fill="#1A140C" fontSize="7.5" fontFamily="'Plus Jakarta Sans', sans-serif"
            textAnchor="end" fontWeight="600">{value}</text>
          <line x1="28" y1={y + 5} x2="192" y2={y + 5} stroke="#F6F2EC" strokeWidth="0.8" strokeDasharray="3,3"/>
        </g>
      ))}
      <rect x="24" y="206" width="172" height="24" rx="6" fill="#FBF8F4" stroke="#E0D8CF" strokeWidth="1"/>
      <text x="36" y="221" fill="#5C4A36" fontSize="7.5" fontFamily="'Plus Jakarta Sans', sans-serif" fontWeight="600">
        Reste à payer
      </text>
      <text x="188" y="221" fill="#C46318" fontSize="8.5" fontFamily="'JetBrains Mono', monospace"
        textAnchor="end" fontWeight="600">150 000 FCFA</text>
    </svg>
  )
}

