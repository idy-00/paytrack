import { useEffect, useRef, useState } from 'react'
import { Link } from 'react-router-dom'
import { gsap } from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'
import { Menu, X, ArrowRight, CheckCircle2, Star } from 'lucide-react'

gsap.registerPlugin(ScrollTrigger)

/* ─────────────────────────────────────────────────────────────────────────────
   CSS VARIABLES — Acajou & Or palette injected at root
───────────────────────────────────────────────────────────────────────────── */
const CSS_VARS = `
  :root {
    --c-bg:        #F6F2EC;
    --c-surface:   #FFFFFF;
    --c-elevated:  #FBF8F4;
    --c-border:    #E0D8CF;
    --c-primary:   #7B4A1E;
    --c-accent:    #D4891A;
    --c-text-1:    #1A140C;
    --c-text-2:    #5C4A36;
    --c-text-3:    #9B887A;
    --c-success:   #2E7D5A;
    --c-warning:   #C46318;
    --c-danger:    #B82929;
  }
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
`

/* ─────────────────────────────────────────────────────────────────────────────
   SVG ILLUSTRATIONS — redrawn for Acajou & Or palette
───────────────────────────────────────────────────────────────────────────── */

function IlluLedgerDetail() {
  return (
    <svg viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg" className="w-full h-full">
      <rect width="320" height="240" rx="12" fill="#FBF8F4"/>
      <rect x="0" y="0" width="320" height="4" rx="2" fill="#7B4A1E" opacity="0.15"/>
      <text x="20" y="32" fill="#7B4A1E" fontSize="11" fontFamily="'Fraunces', serif" fontWeight="600" letterSpacing="0.04em">
        DOSSIER · VT-2026-0091
      </text>
      <line x1="20" y1="42" x2="300" y2="42" stroke="#E0D8CF" strokeWidth="1"/>
      <text x="20" y="62" fill="#1A140C" fontSize="14" fontFamily="'Fraunces', serif" fontWeight="500">Moussa Diallo</text>
      <text x="20" y="78" fill="#9B887A" fontSize="9" fontFamily="'Plus Jakarta Sans', sans-serif">Boutique Téléphonie · Dakar-Médina</text>
      <text x="20" y="100" fill="#5C4A36" fontSize="10" fontFamily="'Plus Jakarta Sans', sans-serif">Samsung Galaxy A35 · 6 tranches</text>
      <text x="20" y="116" fill="#7B4A1E" fontSize="11" fontFamily="'JetBrains Mono', monospace" fontWeight="600">375 000 FCFA</text>
      <line x1="20" y1="126" x2="300" y2="126" stroke="#E0D8CF" strokeWidth="0.8" strokeDasharray="4,3"/>
      {/* Progress bar */}
      <rect x="20" y="134" width="280" height="5" rx="2.5" fill="#E0D8CF"/>
      <rect x="20" y="134" width="168" height="5" rx="2.5" fill="#D4891A"/>
      <text x="20" y="152" fill="#9B887A" fontSize="8" fontFamily="'JetBrains Mono', monospace">Payé: 225 000</text>
      <text x="200" y="152" fill="#C46318" fontSize="8" fontFamily="'JetBrains Mono', monospace">Restant: 150 000</text>
      <line x1="20" y1="162" x2="300" y2="162" stroke="#E0D8CF" strokeWidth="1"/>
      {/* Tranches */}
      {[
        { y: 178, n: 'T1', date: '15 Fév', status: 'paye' },
        { y: 194, n: 'T2', date: '15 Mar', status: 'paye' },
        { y: 210, n: 'T3', date: '15 Avr', status: 'paye' },
        { y: 226, n: 'T4', date: '15 Mai', status: 'retard' },
      ].map(({ y, n, date, status }) => (
        <g key={n}>
          <circle cx="30" cy={y} r="5"
            fill={status === 'paye' ? '#2E7D5A' : status === 'retard' ? '#C46318' : '#E0D8CF'}/>
          <text x="44" y={y + 4} fill="#5C4A36" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">{n} · {date}</text>
          <text x="280" y={y + 4} fill={status === 'paye' ? '#2E7D5A' : '#C46318'} fontSize="8"
            fontFamily="'JetBrains Mono', monospace" textAnchor="end">
            {status === 'paye' ? '62 500 ✓' : '62 500 !'}
          </text>
        </g>
      ))}
    </svg>
  )
}

function IlluRegisterBook() {
  return (
    <svg viewBox="0 0 300 260" fill="none" xmlns="http://www.w3.org/2000/svg" className="w-full h-full">
      {/* Book spine */}
      <rect x="0" y="0" width="300" height="260" rx="4" fill="#6B3A14"/>
      <rect x="16" y="0" width="284" height="260" rx="4" fill="#FBF8F4"/>
      <rect x="16" y="0" width="6" height="260" fill="#5A3010" opacity="0.4"/>
      {/* Ruled lines */}
      {[40,56,72,88,104,120,136,152,168,184,200,216,232].map(y => (
        <line key={y} x1="28" y1={y} x2="292" y2={y} stroke="#E0D8CF" strokeWidth="0.7"/>
      ))}
      {/* Red margin line */}
      <line x1="55" y1="8" x2="55" y2="252" stroke="#B82929" strokeWidth="0.8" opacity="0.3"/>
      {/* Header */}
      <text x="160" y="26" fill="#7B4A1E" fontSize="11" fontFamily="'Fraunces', serif" fontWeight="600"
        textAnchor="middle" letterSpacing="0.06em">REGISTRE DES CRÉANCES</text>
      {/* Entries */}
      <text x="64" y="56" fill="#1A140C" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">A. Ndiaye · iPhone 15 · 650 000 FCFA</text>
      <text x="64" y="72" fill="#1A140C" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">I. Fall · TV Samsung 55" · 285 000 FCFA</text>
      <text x="64" y="88" fill="#C46318" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">F. Sarr · Frigo LG · 180 000 FCFA ▲</text>
      <text x="64" y="104" fill="#1A140C" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">C. Mbaye · Laptop HP · 420 000 FCFA</text>
      <text x="64" y="120" fill="#1A140C" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">M. Diallo · Galaxy A35 · 375 000 FCFA</text>
      <text x="64" y="136" fill="#2E7D5A" fontSize="8.5" fontFamily="'Plus Jakarta Sans', sans-serif">B. Kane · Clim Daikin · 520 000 FCFA ✓</text>
      {/* Status dots */}
      {[56,72,88,104,120,136].map((y, i) => (
        <circle key={y} cx="40" cy={y - 2} r="4"
          fill={['#D4891A','#2E7D5A','#C46318','#D4891A','#D4891A','#2E7D5A'][i]}/>
      ))}
      {/* Stamp */}
      <circle cx="230" cy="200" r="38" stroke="#7B4A1E" strokeWidth="2" fill="none" opacity="0.15"/>
      <circle cx="230" cy="200" r="32" stroke="#7B4A1E" strokeWidth="1" fill="none" opacity="0.1"/>
      <text x="230" y="196" fill="#7B4A1E" fontSize="7.5" fontFamily="'Fraunces', serif" fontWeight="600"
        textAnchor="middle" letterSpacing="0.08em">PAYTRACK</text>
      <text x="230" y="208" fill="#D4891A" fontSize="6.5" fontFamily="'Fraunces', serif" fontStyle="italic"
        textAnchor="middle">Certifié conforme</text>
    </svg>
  )
}

function IlluQRNewStyle() {
  return (
    <svg viewBox="0 0 260 260" fill="none" xmlns="http://www.w3.org/2000/svg" className="w-full h-full">
