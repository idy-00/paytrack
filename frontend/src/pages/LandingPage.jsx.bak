function IlluMultiShopNew() {
  return (
    <svg viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg" className="w-full h-full">
      <circle cx="130" cy="110" r="32" fill="#7B4A1E"/>
      <text x="130" y="106" fill="white" fontSize="9" fontFamily="'Fraunces', serif" fontWeight="600"
        textAnchor="middle">PayTrack</text>
      <text x="130" y="120" fill="rgba(212,137,26,0.9)" fontSize="7" fontFamily="'Fraunces', serif" fontStyle="italic"
        textAnchor="middle">Central</text>
      {[
        [130, 110, 32, 18],
        [130, 110, 228, 18],
        [130, 110, 32, 202],
        [130, 110, 228, 202],
        [130, 110, 130, 12],
        [130, 110, 130, 208],
      ].map(([x1, y1, x2, y2], i) => (
        <line key={i} x1={x1} y1={y1} x2={x2} y2={y2}
          stroke="#E0D8CF" strokeWidth="1.5" strokeDasharray="4,4"/>
      ))}
      {[
        { cx: 32, cy: 18, label: 'Dakar', c: '#7B4A1E' },
        { cx: 228, cy: 18, label: 'Thiès', c: '#2E7D5A' },
        { cx: 32, cy: 202, label: 'St-Louis', c: '#C46318' },
        { cx: 228, cy: 202, label: 'Ziguinchor', c: '#9B887A' },
        { cx: 130, cy: 12, label: 'Rufisque', c: '#7B4A1E' },
        { cx: 130, cy: 208, label: 'Kaolack', c: '#2E7D5A' },
      ].map(({ cx, cy, label, c }) => (
        <g key={label}>
          <circle cx={cx} cy={cy} r="20" fill={c} opacity="0.12"/>
          <circle cx={cx} cy={cy} r="13" fill={c} opacity="0.2"/>
          <circle cx={cx} cy={cy} r="8" fill={c}/>
          <text x={cx} y={cy + 3} fill="white" fontSize="6.5" fontFamily="'Plus Jakarta Sans', sans-serif"
            textAnchor="middle" fontWeight="700">
            {label.slice(0, 2).toUpperCase()}
          </text>
          <text x={cx} y={cy + 26} fill="#5C4A36" fontSize="6" fontFamily="'Plus Jakarta Sans', sans-serif"
            textAnchor="middle">{label}</text>
        </g>
      ))}
    </svg>
  )
}

/* ─────────────────────────────────────────────────────────────────────────────
   HERO — Grand Registre
───────────────────────────────────────────────────────────────────────────── */
function HeroLedger() {
  return (
    <div className="relative w-full max-w-3xl mx-auto" style={{ fontFamily: "'Fraunces', Georgia, serif" }}>
      {/* Stamp top-left */}
      <div className="flex items-center gap-3 mb-4">
        <div className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0"
          style={{ background: '#7B4A1E' }}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4891A" strokeWidth="2"
            strokeLinecap="round">
            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
          </svg>
        </div>
        <span style={{ fontFamily: "'Plus Jakarta Sans', sans-serif", fontSize: '11px', fontWeight: 700,
          letterSpacing: '0.12em', textTransform: 'uppercase', color: '#9B887A' }}>
          PayTrack · Registre numérique
        </span>
      </div>

      {/* Full-width rule */}
      <div style={{ height: '1px', background: '#E0D8CF', marginBottom: '20px' }} />

      {/* Two-column layout */}
      <div className="grid gap-6" style={{ gridTemplateColumns: '1fr auto' }}>
        {/* Left column — entry 1 */}
        <div id="ledger-entry-1">
          <p style={{ fontFamily: "'Plus Jakarta Sans', sans-serif", fontSize: '10px', fontWeight: 600,
            letterSpacing: '0.08em', textTransform: 'uppercase', color: '#9B887A', marginBottom: '8px' }}>
            Dossier · VT-2026-0091
          </p>
          <h2 style={{ fontSize: 'clamp(22px, 3.5vw, 32px)', fontWeight: 600, color: '#1A140C',
            lineHeight: 1.15, marginBottom: '4px', letterSpacing: '-0.01em' }}>
            MOUSSA DIALLO
          </h2>
          <p style={{ fontFamily: "'Plus Jakarta Sans', sans-serif", fontSize: '14px', color: '#9B887A',
            marginBottom: '16px' }}>
            Boutique Téléphonie · Dakar-Médina
          </p>
          <div style={{ height: '1px', background: '#E0D8CF', marginBottom: '14px' }} />
          <p style={{ fontFamily: "'Plus Jakarta Sans', sans-serif", fontSize: '13px', color: '#5C4A36',
            marginBottom: '6px' }}>
            Samsung Galaxy A35 · 6 tranches · 375 000 FCFA
          </p>
          <p id="ledger-amounts" style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '13px',
            color: '#7B4A1E', marginBottom: '10px' }}>
            Payé: 225 000 · Restant: 150 000
          </p>
          {/* Amber progress bar */}
          <div style={{ height: '4px', background: '#E0D8CF', borderRadius: '2px', marginBottom: '20px' }}>
            <div style={{ height: '100%', width: '60%', background: '#D4891A', borderRadius: '2px',
              transition: 'width 1.8s ease' }} id="ledger-progress" />
          </div>
          {/* Entry 2 — ghost */}
          <div style={{ opacity: 0.3 }}>
            <p style={{ fontFamily: "'Plus Jakarta Sans', sans-serif", fontSize: '10px', fontWeight: 600,
              letterSpacing: '0.08em', textTransform: 'uppercase', color: '#9B887A', marginBottom: '6px' }}>
              Dossier · VT-2026-0088
            </p>
            <h2 style={{ fontSize: 'clamp(18px, 2.8vw, 26px)', fontWeight: 600, color: '#1A140C',
              lineHeight: 1.2, marginBottom: '4px', letterSpacing: '-0.01em' }}>
              AMINATA NDIAYE
            </h2>
            <p style={{ fontFamily: "'Plus Jakarta Sans', sans-serif", fontSize: '13px', color: '#9B887A' }}>
              iPhone 15 Pro Max · 12 tranches · 650 000 FCFA
            </p>
          </div>
        </div>

        {/* Right column — date stamps + tranche marks */}
        <div className="hidden sm:flex flex-col gap-2 text-right" style={{ minWidth: '130px' }}>
          <p style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '10px', color: '#9B887A',
            marginBottom: '24px' }}>
            03 / 07 / 2026
          </p>
          {[
            { n: 'T1', date: '15 Fév', ok: true },
            { n: 'T2', date: '15 Mar', ok: true },
            { n: 'T3', date: '15 Avr', ok: true },
            { n: 'T4', date: '15 Mai', ok: false },
            { n: 'T5', date: '15 Juin', ok: null },
            { n: 'T6', date: '15 Juil', ok: null },
          ].map(({ n, date, ok }) => (
            <div key={n} className="flex items-center justify-end gap-2">
              <span style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '9px', color: '#9B887A' }}>
                {n} · {date}
              </span>
              <span style={{ width: 8, height: 8, borderRadius: '50%', display: 'inline-block', flexShrink: 0,
                background: ok === true ? '#2E7D5A' : ok === false ? '#C46318' : '#E0D8CF' }} />
            </div>
          ))}
        </div>
      </div>

      {/* Notarial seal */}
      <div id="ledger-seal" className="absolute hidden lg:flex flex-col items-center justify-center"
        style={{ bottom: '-20px', right: '-20px', width: '100px', height: '100px' }}>
        <svg viewBox="0 0 100 100" fill="none" className="absolute inset-0 w-full h-full">
          <circle cx="50" cy="50" r="47" stroke="#7B4A1E" strokeWidth="2"/>
          <circle cx="50" cy="50" r="40" stroke="#7B4A1E" strokeWidth="0.8" strokeDasharray="3,3"/>
          <text x="50" y="45" fill="#7B4A1E" fontSize="8" fontFamily="'Fraunces', serif" fontWeight="600"
            textAnchor="middle" letterSpacing="0.05em">CHAQUE</text>
          <text x="50" y="57" fill="#D4891A" fontSize="7.5" fontFamily="'Fraunces', serif" fontStyle="italic"
            textAnchor="middle">tranche.</text>
          <text x="50" y="68" fill="#7B4A1E" fontSize="8" fontFamily="'Fraunces', serif" fontWeight="600"
            textAnchor="middle" letterSpacing="0.04em">SUIVIE.</text>
        </svg>
      </div>
    </div>
  )
}

/* ─────────────────────────────────────────────────────────────────────────────
   NAVBAR
───────────────────────────────────────────────────────────────────────────── */
function NavBar() {
  const ref = useRef(null)
  const [open, setOpen] = useState(false)

  useEffect(() => {
    const fn = () => {
      if (!ref.current) return
      const s = window.scrollY > 24
      ref.current.style.background = s ? 'rgba(246,242,236,0.94)' : 'transparent'
      ref.current.style.backdropFilter = s ? 'blur(14px)' : 'blur(0)'
      ref.current.style.borderBottom = s ? '1px solid #E0D8CF' : '1px solid transparent'
    }
    window.addEventListener('scroll', fn, { passive: true })
    return () => window.removeEventListener('scroll', fn)
  }, [])

  return (
    <nav ref={ref}
      style={{ background: 'transparent', borderBottom: '1px solid transparent', transition: 'all .25s',
        fontFamily: "'Plus Jakarta Sans', sans-serif" }}
      className="fixed top-0 inset-x-0 z-50 px-6 lg:px-12 h-16 flex items-center justify-between">
      <Link to="/" className="flex items-center gap-2.5 no-underline flex-shrink-0">
        <div className="w-8 h-8 rounded-lg flex items-center justify-center"
          style={{ background: '#7B4A1E' }}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4891A" strokeWidth="2.2"
            strokeLinecap="round">
            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
          </svg>
        </div>
        <span style={{ fontFamily: "'Fraunces', Georgia, serif", fontSize: '19px', fontWeight: 600,
          color: '#1A140C', letterSpacing: '-0.01em' }}>
          PayTrack
        </span>
      </Link>

      <div className="hidden md:flex items-center gap-7">
        {[['#features', 'Fonctionnalités'], ['#how', 'Comment ça marche'], ['#pricing', 'Tarifs']].map(([h, l]) => (
          <a key={h} href={h} style={{ fontSize: '14px', fontWeight: 500, color: '#5C4A36',
            textDecoration: 'none', transition: 'color .2s' }}
            onMouseEnter={e => { e.target.style.color = '#7B4A1E' }}
            onMouseLeave={e => { e.target.style.color = '#5C4A36' }}>
            {l}
          </a>
        ))}
      </div>

      <Link to="/login" className="hidden md:inline-flex items-center gap-2 no-underline"
        style={{ padding: '9px 20px', borderRadius: '10px', fontSize: '14px', fontWeight: 600,
          background: '#7B4A1E', color: 'white', boxShadow: '0 2px 10px rgba(123,74,30,0.25)',
          transition: 'all .2s' }}
        onMouseEnter={e => { e.currentTarget.style.background = '#6B3A14' }}
        onMouseLeave={e => { e.currentTarget.style.background = '#7B4A1E' }}>
        Connexion <ArrowRight size={14} />
      </Link>

      <button className="md:hidden" onClick={() => setOpen(v => !v)} aria-label="Menu"
        style={{ color: '#7B4A1E' }}>
        {open ? <X size={22} /> : <Menu size={22} />}
      </button>

      {open && (
        <div className="md:hidden absolute top-16 inset-x-0 border-b px-6 py-5 flex flex-col gap-4 z-50"
          style={{ background: '#F6F2EC', borderColor: '#E0D8CF', boxShadow: '0 8px 32px rgba(123,74,30,0.1)',
            fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
          {[['#features', 'Fonctionnalités'], ['#how', 'Comment ça marche'], ['#pricing', 'Tarifs']].map(([h, l]) => (
            <a key={h} href={h} onClick={() => setOpen(false)} style={{ fontSize: '15px', fontWeight: 500,
              color: '#5C4A36', textDecoration: 'none' }}>
              {l}
            </a>
          ))}
          <Link to="/login" onClick={() => setOpen(false)} className="flex items-center justify-center gap-2 no-underline"
            style={{ padding: '11px 0', borderRadius: '10px', fontSize: '15px', fontWeight: 600,
              background: '#7B4A1E', color: 'white' }}>
            Connexion <ArrowRight size={14} />
          </Link>
        </div>
      )}
    </nav>
  )
}

/* ─────────────────────────────────────────────────────────────────────────────
   PAGE
───────────────────────────────────────────────────────────────────────────── */
export default function LandingPage() {
  const heroRef = useRef(null)
  const tlRef = useRef(null)

  useEffect(() => {
    // Inject fonts + CSS vars
    const styleEl = document.createElement('style')
    styleEl.textContent = CSS_VARS
    document.head.appendChild(styleEl)

    // Hero animations
    gsap.set('#ledger-stamp', { opacity: 0, x: -24 })
    gsap.set('#ledger-rule', { scaleX: 0, transformOrigin: 'left center' })
    gsap.set('#ledger-entry-1', { opacity: 0, y: 28 })
    gsap.set('#ledger-date-col', { opacity: 0, x: 20 })
    gsap.set('#ledger-seal', { opacity: 0, scale: 0.7, rotation: -15, transformOrigin: 'center' })
    gsap.set('#ledger-cta', { opacity: 0, y: 16 })
    gsap.set('#h-proof', { opacity: 0, y: 12 })

    const tl = gsap.timeline({ delay: 0.2 })
    tlRef.current = tl

    tl.to('#ledger-stamp', { opacity: 1, x: 0, duration: 0.6, ease: 'power3.out' })
      .to('#ledger-rule', { scaleX: 1, duration: 0.8, ease: 'power3.out' }, '-=0.2')
      .to('#ledger-entry-1', { opacity: 1, y: 0, duration: 0.75, ease: 'power3.out' }, '-=0.4')
      .to('#ledger-date-col', { opacity: 1, x: 0, duration: 0.6, ease: 'power2.out' }, '-=0.35')
      .to('#ledger-seal', { opacity: 1, scale: 1, rotation: 0, duration: 0.9, ease: 'elastic.out(1,0.6)' }, '-=0.2')
      .to('#ledger-cta', { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' }, '-=0.5')
      .to('#h-proof', { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.3')

    // Mouse parallax
    const onMouse = e => {
      const xP = (e.clientX / window.innerWidth - 0.5) * 2
      const yP = (e.clientY / window.innerHeight - 0.5) * 2
      gsap.to('#bg-blob-1', { x: xP * -18, y: yP * -12, duration: 1.4, ease: 'power1.out' })
      gsap.to('#bg-blob-2', { x: xP * 14, y: yP * 18, duration: 1.6, ease: 'power1.out' })
    }
    window.addEventListener('mousemove', onMouse)

    // Feature rows reveal
    gsap.utils.toArray('.feat-row').forEach((el, i) => {
      const dir = i % 2 === 0 ? -40 : 40
      gsap.set(el, { opacity: 0, x: dir })
      gsap.to(el, {
        opacity: 1, x: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 82%' }
      })
    })

    // Cards
    gsap.utils.toArray('.rc').forEach((el, i) => {
      gsap.set(el, { opacity: 0, y: 24 })
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.55, delay: (i % 3) * 0.08, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' }
      })
    })

    // Steps
    gsap.utils.toArray('.step-item').forEach((el, i) => {
      gsap.set(el, { opacity: 0, y: 22 })
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.5, delay: i * 0.12, ease: 'power2.out',
        scrollTrigger: { trigger: '.steps-wrap', start: 'top 80%' }
      })
    })

    // Counters
    gsap.utils.toArray('[data-count]').forEach(el => {
      const target = parseInt(el.dataset.count)
      const suffix = el.dataset.suffix || ''
      const obj = { val: 0 }
      ScrollTrigger.create({
        trigger: el, start: 'top 86%', once: true,
        onEnter: () => gsap.to(obj, {
          val: target, duration: 2, ease: 'power2.out',
          onUpdate: () => { el.textContent = Math.round(obj.val).toLocaleString('fr-FR') + suffix }
        })
      })
    })

    // CTA block
    gsap.set('#cta-block', { opacity: 0, y: 32 })
    gsap.to('#cta-block', {
      opacity: 1, y: 0, duration: 0.9, ease: 'power3.out',
      scrollTrigger: { trigger: '#cta-block', start: 'top 76%' }
    })

    // 3D card hover
    const cards = document.querySelectorAll('.card-3d')
    cards.forEach(card => {
      card.addEventListener('mousemove', e => {
        const r = card.getBoundingClientRect()
        const xRel = (e.clientX - r.left) / r.width - 0.5
        const yRel = (e.clientY - r.top) / r.height - 0.5
        gsap.to(card, {
          rotateY: xRel * 6, rotateX: -yRel * 5,
          duration: 0.4, ease: 'power1.out', transformPerspective: 900
        })
      })
      card.addEventListener('mouseleave', () => {
        gsap.to(card, { rotateY: 0, rotateX: 0, duration: 0.6, ease: 'power2.out' })
      })
    })

    return () => {
      window.removeEventListener('mousemove', onMouse)
      if (tlRef.current) tlRef.current.kill()
      ScrollTrigger.getAll().forEach(t => t.kill())
      document.head.removeChild(styleEl)
    }
  }, [])

  return (
    <div style={{ background: '#F6F2EC', overflowX: 'hidden', fontFamily: "'Plus Jakarta Sans', sans-serif" }}>
      <NavBar />

      {/* ── HERO ──────────────────────────────────────────────────────────── */}
      <section ref={heroRef}
        className="relative min-h-screen flex flex-col justify-center px-6 lg:px-12 pt-28 pb-24 overflow-hidden">
        {/* Ambient blobs */}
        <div className="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
          <div id="bg-blob-1" className="absolute rounded-full"
            style={{ width: 600, height: 600, top: -160, right: -100,
              background: 'radial-gradient(circle, rgba(123,74,30,0.07) 0%, transparent 65%)' }} />
          <div id="bg-blob-2" className="absolute rounded-full"
            style={{ width: 480, height: 480, bottom: -100, left: -80,
              background: 'radial-gradient(circle, rgba(212,137,26,0.06) 0%, transparent 65%)' }} />
          {/* Subtle dot grid */}
          <div className="absolute inset-0 opacity-[0.025]"
            style={{ backgroundImage: 'radial-gradient(circle, #7B4A1E 1px, transparent 1px)',
              backgroundSize: '30px 30px' }} />
        </div>

        <div className="relative z-10 max-w-4xl mx-auto w-full">
          {/* Stamp header */}
          <div id="ledger-stamp" className="flex items-center gap-3 mb-5">
            <div className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0"
              style={{ background: '#7B4A1E' }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4891A" strokeWidth="2"
                strokeLinecap="round">
                <path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
              </svg>
            </div>
            <span style={{ fontSize: '11px', fontWeight: 700, letterSpacing: '0.12em',
              textTransform: 'uppercase', color: '#9B887A' }}>
              PayTrack · Registre numérique de créances
            </span>
          </div>

          {/* Full-width rule */}
          <div id="ledger-rule" style={{ height: '1px', background: '#E0D8CF', marginBottom: '28px' }} />

          {/* Ledger body */}
          <div className="grid gap-8" style={{ gridTemplateColumns: '1fr auto' }}>
            {/* Left — entry */}
            <div id="ledger-entry-1">
              <p style={{ fontSize: '10px', fontWeight: 700, letterSpacing: '0.1em',
                textTransform: 'uppercase', color: '#9B887A', marginBottom: '10px' }}>
                Dossier en cours · VT-2026-0091
              </p>
              <h1 style={{ fontFamily: "'Fraunces', Georgia, serif",
                fontSize: 'clamp(28px, 5vw, 52px)', fontWeight: 600,
                color: '#1A140C', lineHeight: 1.1, marginBottom: '6px', letterSpacing: '-0.02em' }}>
                MOUSSA DIALLO
              </h1>
              <p style={{ fontSize: '15px', color: '#9B887A', marginBottom: '20px' }}>
                Boutique Téléphonie · Dakar-Médina
              </p>

              <div style={{ height: '1px', background: '#E0D8CF', marginBottom: '18px' }} />

              <p style={{ fontSize: '14px', color: '#5C4A36', marginBottom: '8px',
                fontFamily: "'Fraunces', Georgia, serif" }}>
                Samsung Galaxy A35 · 6 tranches · 375 000 FCFA
              </p>
              <p style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '13px',
                color: '#7B4A1E', marginBottom: '12px', letterSpacing: '0.01em' }}>
                Payé: 225 000 · Restant: 150 000
              </p>

              {/* Amber progress bar — bleeds left */}
              <div style={{ height: '3px', background: '#E0D8CF', borderRadius: '2px',
                marginBottom: '24px', marginLeft: '-24px' }}>
                <div style={{ height: '100%', width: '60%', background: '#D4891A', borderRadius: '2px' }} />
              </div>

              {/* Ghost entry 2 */}
              <div style={{ opacity: 0.28 }}>
                <div style={{ height: '1px', background: '#E0D8CF', marginBottom: '16px' }} />
                <p style={{ fontSize: '10px', fontWeight: 700, letterSpacing: '0.1em',
                  textTransform: 'uppercase', color: '#9B887A', marginBottom: '8px' }}>
                  Dossier · VT-2026-0088
                </p>
                <p style={{ fontFamily: "'Fraunces', Georgia, serif",
                  fontSize: 'clamp(20px, 3vw, 32px)', fontWeight: 600, color: '#1A140C',
                  lineHeight: 1.15, marginBottom: '4px' }}>
                  AMINATA NDIAYE
                </p>
                <p style={{ fontSize: '13px', color: '#9B887A' }}>
                  iPhone 15 Pro Max · 12 tranches · 650 000 FCFA
                </p>
              </div>
            </div>

            {/* Right — date / tranche marks */}
            <div id="ledger-date-col" className="hidden sm:flex flex-col gap-2.5 text-right pt-1"
              style={{ minWidth: '140px' }}>
              <p style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '10px',
                color: '#9B887A', marginBottom: '20px' }}>
                03 / 07 / 2026
              </p>
              {[
                { n: 'T1', date: '15 Fév', ok: true },
                { n: 'T2', date: '15 Mar', ok: true },
                { n: 'T3', date: '15 Avr', ok: true },
                { n: 'T4', date: '15 Mai', ok: false },
                { n: 'T5', date: '15 Juin', ok: null },
                { n: 'T6', date: '15 Juil', ok: null },
              ].map(({ n, date, ok }) => (
                <div key={n} className="flex items-center justify-end gap-2">
                  <span style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '9.5px', color: '#9B887A' }}>
                    {n} · {date}
                  </span>
                  <span style={{
                    width: 9, height: 9, borderRadius: '50%', display: 'inline-block', flexShrink: 0,
                    background: ok === true ? '#2E7D5A' : ok === false ? '#C46318' : '#E0D8CF',
                    border: ok === null ? '1.5px solid #E0D8CF' : 'none'
                  }} />
                </div>
              ))}
            </div>
          </div>

          {/* Notarial seal — absolute positioned */}
          <div id="ledger-seal" className="hidden lg:flex"
            style={{ position: 'absolute', bottom: '-8px', right: '48px',
              width: '110px', height: '110px', alignItems: 'center', justifyContent: 'center' }}>
            <svg viewBox="0 0 110 110" fill="none" className="absolute inset-0 w-full h-full">
              <circle cx="55" cy="55" r="52" stroke="#7B4A1E" strokeWidth="2"/>
              <circle cx="55" cy="55" r="44" stroke="#7B4A1E" strokeWidth="0.8" strokeDasharray="3,4"/>
              <text x="55" y="46" fill="#7B4A1E" fontSize="8.5" fontFamily="'Fraunces', serif" fontWeight="600"
                textAnchor="middle" letterSpacing="0.08em">CHAQUE</text>
              <text x="55" y="60" fill="#D4891A" fontSize="9" fontFamily="'Fraunces', serif" fontStyle="italic"
                textAnchor="middle">tranche.</text>
              <text x="55" y="74" fill="#7B4A1E" fontSize="8.5" fontFamily="'Fraunces', serif" fontWeight="600"
                textAnchor="middle" letterSpacing="0.06em">SUIVIE.</text>
            </svg>
          </div>

          {/* CTA — underlined text link, not a button */}
          <div id="ledger-cta" style={{ marginTop: '48px', display: 'flex', flexDirection: 'column', gap: '16px' }}>
            <div style={{ height: '1px', background: '#E0D8CF', marginBottom: '4px' }} />
            <Link to="/login" className="inline-flex items-center gap-1 no-underline"
              style={{ fontFamily: "'Fraunces', Georgia, serif", fontSize: 'clamp(18px, 2.5vw, 26px)',
                fontWeight: 500, color: '#7B4A1E', textDecoration: 'underline',
                textDecorationColor: '#D4891A', textUnderlineOffset: '6px',
                textDecorationThickness: '2px', width: 'fit-content' }}>
              Créer votre registre →
            </Link>
            <div id="h-proof" className="flex items-center gap-3"
              style={{ fontSize: '13px', color: '#9B887A' }}>
              <div className="flex">
                {['#7B4A1E', '#2E7D5A', '#C46318', '#9B887A'].map((bg, i) => (
                  <div key={i} style={{ background: bg, marginLeft: i === 0 ? 0 : -8, fontSize: 8,
                    width: 28, height: 28, borderRadius: '50%', border: '2px solid #F6F2EC',
                    display: 'flex', alignItems: 'center', justifyContent: 'center',
                    color: 'white', fontWeight: 700 }}>
                    {['MD', 'FA', 'IK', 'RD'][i]}
                  </div>
                ))}
              </div>
              <span>+200 commerçants font confiance à PayTrack</span>
            </div>
          </div>
        </div>
      </section>

