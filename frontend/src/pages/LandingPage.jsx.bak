                style={{
                  background: featured ? '#7B4A1E' : 'white',
                  border: `1px solid ${featured ? '#7B4A1E' : '#E0D8CF'}`,
                  boxShadow: featured ? '0 8px 40px rgba(123,74,30,0.22)' : '0 2px 12px rgba(123,74,30,0.04)',
                  transition: 'all .2s'
                }}>
                {badge && (
                  <span style={{ position: 'absolute', top: -14, left: '50%', transform: 'translateX(-50%)',
                    background: '#D4891A', color: 'white', fontSize: '11px', fontWeight: 700,
                    padding: '4px 16px', borderRadius: '20px', whiteSpace: 'nowrap', letterSpacing: '0.04em' }}>
                    {badge}
                  </span>
                )}
                <p style={{ fontSize: '11px', fontWeight: 700, letterSpacing: '0.1em',
                  textTransform: 'uppercase', color: featured ? 'rgba(212,137,26,0.8)' : '#9B887A',
                  marginBottom: '12px' }}>
                  {plan}
                </p>
                <div style={{ fontFamily: "'JetBrains Mono', monospace",
                  fontSize: '38px', fontWeight: 600, color: featured ? 'white' : '#1A140C',
                  lineHeight: 1, marginBottom: '6px' }}>
                  {price.includes('FCFA') ? (
                    <>{price.replace(' FCFA', '')}<span style={{ fontSize: '15px', fontWeight: 400,
                      color: featured ? 'rgba(255,255,255,0.5)' : '#9B887A', marginLeft: '6px', fontFamily: "'Plus Jakarta Sans', sans-serif" }}>FCFA</span></>
                  ) : price}
                </div>
                <p style={{ fontSize: '13px', color: featured ? 'rgba(255,255,255,0.45)' : '#9B887A',
                  marginBottom: '28px' }}>
                  {period}
                </p>
                <ul style={{ listStyle: 'none', padding: 0, margin: '0 0 32px 0', display: 'flex',
                  flexDirection: 'column', gap: '12px' }}>
                  {features.map(f => (
                    <li key={f} className="flex items-start gap-2.5"
                      style={{ fontSize: '14px', color: featured ? 'rgba(255,255,255,0.7)' : '#5C4A36', fontWeight: 300 }}>
                      <CheckCircle2 size={15} style={{ color: featured ? '#D4891A' : '#2E7D5A',
                        flexShrink: 0, marginTop: '2px' }} />
                      {f}
                    </li>
                  ))}
                </ul>
                {ctaLink.startsWith('mailto') ? (
                  <a href={ctaLink} style={{ display: 'block', textAlign: 'center', padding: '12px 0',
                    borderRadius: '10px', fontSize: '14px', fontWeight: 600, textDecoration: 'none',
                    border: `1px solid ${featured ? 'rgba(255,255,255,0.25)' : '#E0D8CF'}`,
                    color: featured ? 'white' : '#7B4A1E', transition: 'all .2s' }}>
                    {cta}
                  </a>
                ) : (
                  <Link to={ctaLink} style={{ display: 'block', textAlign: 'center', padding: '12px 0',
                    borderRadius: '10px', fontSize: '14px', fontWeight: 600, textDecoration: 'none',
                    background: featured ? 'rgba(255,255,255,0.12)' : '#7B4A1E',
                    border: featured ? '1px solid rgba(255,255,255,0.2)' : '1px solid #7B4A1E',
                    color: featured ? 'white' : 'white', transition: 'all .2s' }}>
                    {cta}
                  </Link>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── CTA FINAL ─────────────────────────────────────────────────────── */}
      <section style={{ padding: '96px 24px', position: 'relative', overflow: 'hidden',
        background: 'linear-gradient(180deg, #F6F2EC 0%, #FBF8F4 100%)',
        borderTop: '1px solid #E0D8CF' }}>
        <div className="absolute pointer-events-none rounded-full"
          style={{ width: 700, height: 700, top: '50%', left: '50%',
            transform: 'translate(-50%, -50%)',
            background: 'radial-gradient(circle, rgba(212,137,26,0.06) 0%, transparent 60%)' }} />
        <div id="cta-block" className="relative z-10 text-center max-w-2xl mx-auto">
          {/* Decorative register rule */}
          <div style={{ width: 120, height: 1, background: '#E0D8CF', margin: '0 auto 32px' }} />
          <h2 style={{ fontFamily: "'Fraunces', Georgia, serif",
            fontSize: 'clamp(32px, 5.5vw, 64px)', color: '#1A140C',
            lineHeight: 1.05, letterSpacing: '-0.02em', marginBottom: '24px' }}>
            Prêt à ne plus perdre{' '}
            <em style={{ fontStyle: 'italic', fontWeight: 300, color: '#7B4A1E' }}>
              une seule tranche ?
            </em>
          </h2>
          <p style={{ fontSize: '17px', color: '#5C4A36', fontWeight: 300, marginBottom: '40px',
            maxWidth: '38ch', margin: '0 auto 40px', lineHeight: 1.7 }}>
            Créez votre compte en 2 minutes. Aucune carte bancaire requise pour commencer.
          </p>

          {/* CTA styled as a ledger action */}
          <div className="flex items-center justify-center gap-4 flex-wrap mb-6">
            <Link to="/login" className="inline-flex items-center gap-2.5 no-underline"
              style={{ padding: '16px 36px', borderRadius: '12px', fontSize: '16px', fontWeight: 600,
                background: '#7B4A1E', color: 'white',
                boxShadow: '0 4px 24px rgba(123,74,30,0.28)',
                transition: 'all .2s', fontFamily: "'Plus Jakarta Sans', sans-serif" }}
              onMouseEnter={e => { e.currentTarget.style.background = '#6B3A14'; e.currentTarget.style.transform = 'translateY(-2px)'; e.currentTarget.style.boxShadow = '0 8px 36px rgba(123,74,30,0.35)' }}
              onMouseLeave={e => { e.currentTarget.style.background = '#7B4A1E'; e.currentTarget.style.transform = 'none'; e.currentTarget.style.boxShadow = '0 4px 24px rgba(123,74,30,0.28)' }}>
              Commencer gratuitement <ArrowRight size={17} />
            </Link>
            <a href="mailto:contact@paytrack.sn" className="inline-flex items-center gap-2 no-underline"
              style={{ padding: '16px 28px', borderRadius: '12px', fontSize: '16px', fontWeight: 500,
                border: '1px solid #E0D8CF', color: '#7B4A1E', transition: 'all .2s',
                fontFamily: "'Plus Jakarta Sans', sans-serif" }}
              onMouseEnter={e => { e.currentTarget.style.borderColor = '#7B4A1E'; e.currentTarget.style.background = '#FBF8F4' }}
              onMouseLeave={e => { e.currentTarget.style.borderColor = '#E0D8CF'; e.currentTarget.style.background = 'transparent' }}>
              Demander une démo
            </a>
          </div>

          <p style={{ fontSize: '13px', color: '#9B887A' }}>
            14 jours gratuits · Sans engagement · Support en français
          </p>
          <div style={{ width: 120, height: 1, background: '#E0D8CF', margin: '32px auto 0' }} />
        </div>
      </section>

      {/* ── FOOTER ────────────────────────────────────────────────────────── */}
      <footer style={{ background: '#1A140C', padding: '56px 24px' }}>
        <div className="max-w-6xl mx-auto">
          <div className="grid grid-cols-2 md:grid-cols-4 gap-10 pb-10"
            style={{ borderBottom: '1px solid rgba(255,255,255,0.07)' }}>
            <div className="col-span-2 md:col-span-1">
              <div className="flex items-center gap-2.5 mb-4">
                <div style={{ width: 32, height: 32, background: 'rgba(212,137,26,0.12)',
                  borderRadius: '8px', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4891A" strokeWidth="2"
                    strokeLinecap="round">
                    <path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
                  </svg>
                </div>
                <span style={{ fontFamily: "'Fraunces', Georgia, serif", fontSize: '19px',
                  fontWeight: 600, color: 'white' }}>
                  PayTrack
                </span>
              </div>
              <p style={{ fontSize: '13px', color: 'rgba(255,255,255,0.32)', lineHeight: 1.65, fontWeight: 300 }}>
                La solution de suivi de paiements par tranche pour les commerçants d'Afrique de l'Ouest.
              </p>
            </div>
            {[
              { h: 'Produit', links: [['#features', 'Fonctionnalités'], ['#pricing', 'Tarifs'], ['#how', 'Comment ça marche'], ['/login', 'Connexion', true]] },
              { h: 'Ressources', links: [['#', 'Documentation'], ['#', 'Guide démarrage'], ['#', 'API'], ['#', 'Intégrations']] },
              { h: 'Contact', links: [['mailto:contact@paytrack.sn', 'contact@paytrack.sn'], ['#', 'WhatsApp support'], ['#', 'Confidentialité'], ['#', 'Conditions']] },
            ].map(({ h, links }) => (
              <div key={h}>
                <p style={{ fontSize: '11px', fontWeight: 700, letterSpacing: '0.1em',
                  textTransform: 'uppercase', color: 'rgba(255,255,255,0.28)', marginBottom: '20px' }}>
                  {h}
                </p>
                <div className="flex flex-col gap-3">
                  {links.map(([href, label, isRoute]) =>
                    isRoute ? (
                      <Link key={label} to={href} style={{ fontSize: '13px', color: 'rgba(255,255,255,0.45)',
                        textDecoration: 'none', transition: 'color .2s', fontWeight: 300 }}>
                        {label}
                      </Link>
                    ) : (
                      <a key={label} href={href} style={{ fontSize: '13px', color: 'rgba(255,255,255,0.45)',
                        textDecoration: 'none', transition: 'color .2s', fontWeight: 300 }}>
                        {label}
                      </a>
                    )
                  )}
                </div>
              </div>
            ))}
          </div>
          <div className="flex flex-col sm:flex-row justify-between items-center gap-2 pt-7"
            style={{ fontSize: '12px', color: 'rgba(255,255,255,0.2)' }}>
            <span>© 2026 PayTrack. Tous droits réservés.</span>
            <span style={{ color: 'rgba(212,137,26,0.5)' }}>Fait pour l'Afrique de l'Ouest</span>
          </div>
        </div>
      </footer>
    </div>
  )
}
